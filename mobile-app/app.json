{
  "expo": {
    "name": "YCKF",
    "slug": "yckf-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a8a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yckf.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs location access to capture GPS coordinates for cybercrime reports and location sharing.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs location access to capture GPS coordinates for cybercrime reports and location sharing.",
        "NSCameraUsageDescription": "This app needs camera access to capture photo evidence for cybercrime reports.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select evidence photos for cybercrime reports."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1e3a8a"
      },
      "package": "com.yckf.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "color": "#1e3a8a"
        }
      ],
      "expo-font",
      "expo-mail-composer"
    ],
    "owner": "yckflab",
    "extra": {
      "eas": {
        "projectId": "5e76d348-6cfa-4810-82dc-6b1ad8776174"
      }
    }
  }
}
