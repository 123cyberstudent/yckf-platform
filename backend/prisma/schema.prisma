generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INVESTIGATOR
  VOLUNTEER
  USER
}

enum Platform {
  MOBILE
  WEB
}

model User {
  id                      Int            @id @default(autoincrement())
  email                   String         @unique
  passwordHash            String
  fullName                String
  role                    Role           @default(USER)
  isActive                Boolean        @default(true)
  failedLoginAttempts     Int            @default(0)
  lockoutUntil            DateTime?
  suspendedUntil          DateTime?
  passwordChangedAt       DateTime?
  createdAt               DateTime       @default(now())
  lastLogin               DateTime?
  platform                Platform     @default(WEB)
  twoFactorEnabled        Boolean        @default(false)
  twoFactorSecret         String?
  twoFactorBackupCodes    String[]       @default([])
  twoFactorTrustedDevices Json?
  fcmTokens               String[]       @default([])
  reports                 Report[]
  casesAssigned           Case[]         @relation("InvestigatorCases")
  uploadedEvidence        Evidence[]
  auditLogs               AuditLog[]
  investigationNotes      InvestigationNote[]
  caseHistoryChanges      CaseHistory[]
  refreshTokens           RefreshToken[]
  notifications           Notification[] @relation("UserNotifications")
  sentNotifications       Notification[] @relation("SentNotifications")
  createdCoupons          Coupon[]
  couponRedemptions       CouponRedemption[]
  loginLogs               LoginLog[]
  caseResponses           CaseResponse[]
}

model Report {
  id           Int       @id @default(autoincrement())
  ticketNumber String    @unique
  user         User      @relation(fields: [userId], references: [id])
  userId       Int
  title        String
  description  String
  incidentType String
  priority     String
  status       String
  location     String
  reporterName String?
  reporterEmail String?
  reporterPhone String?
  gpsLatitude  Float?
  gpsLongitude Float?
  gpsAccuracy  Float?
  gpsAddress   String?
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cases        Case[]
  evidence     Evidence[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([ticketNumber])
}

model Case {
  id                     Int                 @id @default(autoincrement())
  report                 Report              @relation(fields: [reportId], references: [id])
  reportId               Int
  assignedInvestigator   User?               @relation("InvestigatorCases", fields: [assignedInvestigatorId], references: [id])
  assignedInvestigatorId Int?
  status                 String
  resolutionNotes        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  notes                  InvestigationNote[]
  history                CaseHistory[]
  notifications          Notification[]
  responses              CaseResponse[]

  @@index([assignedInvestigatorId])
  @@index([status])
}

model Evidence {
  id           Int      @id @default(autoincrement())
  report       Report   @relation(fields: [reportId], references: [id])
  reportId     Int
  fileUrl      String
  fileHash     String
  fileType     String
  metadata     Json?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById Int
  uploadedAt   DateTime @default(now())

  @@index([reportId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  action    String
  targetId  Int?
  ipAddress String
  timestamp DateTime @default(now())
}

model InvestigationNote {
  id        Int      @id @default(autoincrement())
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    Int
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  note      String
  createdAt DateTime @default(now())
}

model CaseHistory {
  id         Int      @id @default(autoincrement())
  case       Case     @relation(fields: [caseId], references: [id])
  caseId     Int
  oldStatus  String
  newStatus  String
  changedBy  User     @relation(fields: [changedById], references: [id])
  changedById Int
  changedAt  DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  body        String
  link        String?
  recipient   User?    @relation("UserNotifications", fields: [recipientId], references: [id])
  recipientId Int?
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id])
  senderId    Int?
  case        Case?    @relation(fields: [caseId], references: [id])
  caseId      Int?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, isRead])
}

model ContentPage {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   Json
  updatedAt DateTime @updatedAt
}

model WhatsAppConversation {
  id           Int      @id @default(autoincrement())
  phoneNumber  String   @unique
  lastMessageAt DateTime
  messageCount Int      @default(1)
  createdAt    DateTime @default(now())
}

model LoginLog {
  id          Int       @id @default(autoincrement())
  email       String
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id])
  success     Boolean
  ipAddress   String
  userAgent   String?
  deviceInfo  String?
  failureReason String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

model Coupon {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  description    String?
  discountPercent Int?
  durationHours  Int                @default(24)
  maxUses        Int?
  usedCount      Int                @default(0)
  isActive       Boolean            @default(true)
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  createdBy      User?              @relation(fields: [createdById], references: [id])
  createdById    Int?
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id          Int      @id @default(autoincrement())
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  couponId    Int
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  redeemedAt  DateTime @default(now())
  expiresAt   DateTime?

  @@unique([couponId, userId])
}

model SiteStat {
  id        Int      @id @default(autoincrement())
  section   String   @default("hero")
  stat      String
  label     String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}

model VolunteerRequest {
  id                Int      @id @default(autoincrement())
  fullName          String
  email             String
  phone             String?
  professionalField String?
  skills            String?
  yearsOfExperience String?
  motivation        String
  referralSource    String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model EmergencyReport {
  id                Int      @id @default(autoincrement())
  ticketNumber      String   @unique
  reporterName      String?
  reporterPhone     String?
  reporterEmail     String?
  description       String?
  audioFileUrl      String?
  audioDuration     Float?
  audioMimeType     String?
  stationName       String?
  stationPhone      String?
  stationAddress    String?
  stationLatitude   Float?
  stationLongitude  Float?
  gpsLatitude       Float?
  gpsLongitude      Float?
  gpsAccuracy       Float?
  gpsAddress        String?
  status            String   @default("new")
  priority          String   @default("high")
  assignedVolunteerId Int?
  adminNotes        String?
  emailStatus       String   @default("queued")
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([createdAt])
}

model Specialist {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  phone       String?
  specialty   String
  bio         String?
  avatarUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedBookings Booking[]

  @@index([specialty])
  @@index([isActive])
}

model Booking {
  id                    Int       @id @default(autoincrement())
  ticketNumber          String    @unique
  fullName              String
  email                 String
  phone                 String
  specialist            String?
  preferredDate         DateTime?
  preferredTime         String?
  caseDescription       String
  paymentMethod         String?
  paymentReference      String?
  status                String    @default("new")
  assignedVolunteerId   Int?
  assignedSpecialistId  Int?
  adminNotes            String?
  emailStatus           String    @default("queued")
  submittedAt           DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignedSpecialist Specialist? @relation(fields: [assignedSpecialistId], references: [id])

  @@index([ticketNumber])
  @@index([status])
  @@index([email])
  @@index([assignedSpecialistId])
  @@index([createdAt])
}

model Enquiry {
  id                Int      @id @default(autoincrement())
  ticketNumber      String   @unique
  name              String
  email             String
  phone             String?
  subject           String?
  message           String
  channel           String   @default("form")
  status            String   @default("new")
  adminNotes        String?
  emailStatus       String   @default("queued")
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([createdAt])
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  ticketNumber      String?
  reportType        String
  recipientEmail    String
  subject           String
  status            String   @default("queued")
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([ticketNumber])
  @@index([reportType])
  @@index([status])
  @@index([createdAt])
}

model Member {
  id          Int      @id @default(autoincrement())
  name        String
  role        String
  bio         String?
  email       String?
  linkedin    String?
  twitter     String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model CaseResponse {
  id          Int      @id @default(autoincrement())
  case        Case     @relation(fields: [caseId], references: [id])
  caseId      Int
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
  responseText String
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([authorId])
}
