generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INVESTIGATOR
  VOLUNTEER
  USER
}

enum Platform {
  MOBILE
  WEB
}

model User {
  id                      Int            @id @default(autoincrement())
  email                   String         @unique
  phone                   String?        @unique
  phoneVerified           Boolean        @default(false)
  emailVerified           Boolean        @default(false)
  passwordHash            String
  fullName                String
  role                    Role           @default(USER)
  isActive                Boolean        @default(true)
  failedLoginAttempts     Int            @default(0)
  lockoutUntil            DateTime?
  suspendedUntil          DateTime?
  passwordChangedAt       DateTime?
  createdAt               DateTime       @default(now())
  lastLogin               DateTime?
  platform                Platform     @default(WEB)
  twoFactorEnabled        Boolean        @default(false)
  twoFactorSecret         String?
  twoFactorBackupCodes    String[]       @default([])
  twoFactorTrustedDevices Json?
  fcmTokens               String[]       @default([])
  referralCode            String?        @unique
  referredByUserId        Int?
  referredBy              User?          @relation("UserReferredBy", fields: [referredByUserId], references: [id])
  referredUsers           User[]         @relation("UserReferredBy")
  premiumStartsAt         DateTime?
  premiumExpiresAt        DateTime?
  subscriptionStatus      String         @default("inactive")
  currentSubscriptionPlanId Int?
  reports                 Report[]
  emergencyReports        EmergencyReport[]
  casesAssigned           Case[]         @relation("InvestigatorCases")
  uploadedEvidence        Evidence[]
  auditLogs               AuditLog[]
  investigationNotes      InvestigationNote[]
  caseHistoryChanges      CaseHistory[]
  refreshTokens           RefreshToken[]
  notifications           Notification[] @relation("UserNotifications")
  sentNotifications       Notification[] @relation("SentNotifications")
  createdCoupons          Coupon[]
  couponRedemptions       CouponRedemption[]
  loginLogs               LoginLog[]
  caseResponses           CaseResponse[]
  wallet                  CreditWallet?
  orders                  Order[]
  paymentAttempts         PaymentAttempt[]
  promotionRedemptions    PromotionRedemption[]
  creditLedgerEntries     CreditLedgerEntry[]
  enrolments              CourseEnrolment[]
  ownedPromoCodes         PromoCode[]              @relation("PromoCodeOwner")
  referralsMade           ReferralRelationship[]   @relation("Referrer")
  referralsReceived       ReferralRelationship[]   @relation("Referred")
  referredAccounts        Referral[]               @relation("ReferredBy")
  referralRewards         Referral[]               @relation("ReferrerReferrals")
  subscriptions           Subscription[]
  subscriptionPayments    SubscriptionPayment[]
  premiumBenefits         PremiumBenefitLedger[]
  promoEngagements        PromotionEngagement[]
  requestedRefunds        Refund[]                 @relation("RefundRequestedBy")
  loginChallenges         LoginChallenge[]
  matchedPasswordResetRequests PasswordResetRequest[] @relation("RequestMatchedUser")
  handledPasswordResetRequests PasswordResetRequest[] @relation("RequestHandledBy")
  assignedEmergencyReports EmergencyReport[]       @relation("AssignedEmergencyReports")
  emergencyAssignmentsMade EmergencyReportAssignment[] @relation("AssignmentsMade")
  emergencyAssignmentsReceived EmergencyReportAssignment[] @relation("AssignmentsReceived")
  broadcastsCreated       Broadcast[]              @relation("BroadcastsCreated")
  broadcastRecipients     BroadcastRecipient[]     @relation("BroadcastsReceived")
  devices                 Device[]
  theftReports            StolenDeviceReport[]

  @@index([referredByUserId])
  @@index([premiumExpiresAt])
}

/// Staff password-reset requests: a volunteer / secondary admin (or investigator)
/// who forgot their login email or password submits a request which the Super
/// Admin approves by sending a reset link or a one-time temporary password.
model PasswordResetRequest {
  id                  Int       @id @default(autoincrement())
  requestNumber       String    @unique
  fullName            String
  email               String?
  phone               String?
  role                String?
  reason              String?
  status              String    @default("pending") // pending | approved | rejected | completed
  action              String?   // reset_link | temp_password
  matchedUserId       Int?
  matchedUser         User?     @relation("RequestMatchedUser", fields: [matchedUserId], references: [id])
  handledById         Int?
  handledBy           User?     @relation("RequestHandledBy", fields: [handledById], references: [id])
  handledAt           DateTime?
  adminNote           String?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([matchedUserId])
}

model Report {
  id           Int       @id @default(autoincrement())
  ticketNumber String    @unique
  user         User      @relation(fields: [userId], references: [id])
  userId       Int
  title        String
  description  String
  incidentType String
  priority     String
  status       String
  location     String
  reporterName String?
  reporterEmail String?
  reporterPhone String?
  gpsLatitude  Float?
  gpsLongitude Float?
  gpsAccuracy  Float?
  gpsAddress   String?
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cases        Case[]
  evidence     Evidence[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([ticketNumber])
}

model Case {
  id                     Int                 @id @default(autoincrement())
  report                 Report              @relation(fields: [reportId], references: [id])
  reportId               Int
  assignedInvestigator   User?               @relation("InvestigatorCases", fields: [assignedInvestigatorId], references: [id])
  assignedInvestigatorId Int?
  status                 String
  resolutionNotes        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  notes                  InvestigationNote[]
  history                CaseHistory[]
  notifications          Notification[]
  responses              CaseResponse[]

  @@index([assignedInvestigatorId])
  @@index([status])
}

model Evidence {
  id           Int      @id @default(autoincrement())
  report       Report   @relation(fields: [reportId], references: [id])
  reportId     Int
  fileUrl      String
  fileHash     String
  fileType     String
  metadata     Json?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById Int
  uploadedAt   DateTime @default(now())

  @@index([reportId])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  user          User?    @relation(fields: [userId], references: [id])
  userId        Int?
  action        String
  entityType    String?
  entityId      Int?
  targetId      Int?
  previousValue Json?
  newValue      Json?
  ipAddress     String
  userAgent     String?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model InvestigationNote {
  id        Int      @id @default(autoincrement())
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    Int
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  note      String
  createdAt DateTime @default(now())
}

model CaseHistory {
  id         Int      @id @default(autoincrement())
  case       Case     @relation(fields: [caseId], references: [id])
  caseId     Int
  oldStatus  String
  newStatus  String
  changedBy  User     @relation(fields: [changedById], references: [id])
  changedById Int
  changedAt  DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id                Int      @id @default(autoincrement())
  type              String
  title             String
  body              String
  link              String?
  priority          String   @default("normal") // low | normal | high | urgent
  relatedEntityType String?
  relatedEntityId   Int?
  recipient         User?    @relation("UserNotifications", fields: [recipientId], references: [id])
  recipientId       Int?
  sender            User?    @relation("SentNotifications", fields: [senderId], references: [id])
  senderId          Int?
  case              Case?    @relation(fields: [caseId], references: [id])
  caseId            Int?
  isRead            Boolean  @default(false)
  readAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([recipientId, isRead])
  @@index([relatedEntityType, relatedEntityId])
}

model ContentPage {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   Json
  updatedAt DateTime @updatedAt
}

model WhatsAppConversation {
  id           Int      @id @default(autoincrement())
  phoneNumber  String   @unique
  lastMessageAt DateTime
  messageCount Int      @default(1)
  createdAt    DateTime @default(now())
}

model LoginChallenge {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id])
  userId       Int
  otpHash      String
  channel      String // EMAIL | SMS | EMAIL_SMS
  expiresAt    DateTime
  attemptCount Int       @default(0)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  ipAddress    String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model LoginLog {
  id          Int       @id @default(autoincrement())
  email       String
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id])
  success     Boolean
  ipAddress   String
  userAgent   String?
  deviceInfo  String?
  failureReason String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

model Coupon {
  id                 Int                @id @default(autoincrement())
  code               String             @unique
  description        String?
  discountPercent    Int?
  durationHours      Int                @default(24)
  accessDurationValue Int               @default(24)
  accessDurationUnit String             @default("hours") // hours | days | months
  validFrom          DateTime?
  expiresAt          DateTime?
  maxUses            Int?
  perUserLimit       Int                @default(1)
  usedCount          Int                @default(0)
  isActive           Boolean            @default(true)
  status             String             @default("active") // active | inactive | expired
  createdAt          DateTime           @default(now())
  createdBy          User?              @relation(fields: [createdById], references: [id])
  createdById        Int?
  redemptions        CouponRedemption[]
}

model CouponRedemption {
  id             Int      @id @default(autoincrement())
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  couponId       Int
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
  redeemedAt     DateTime @default(now())
  accessStartsAt DateTime?
  expiresAt      DateTime?
  status         String   @default("active") // active | expired

  @@unique([couponId, userId])
}

model SiteStat {
  id        Int      @id @default(autoincrement())
  section   String   @default("hero")
  stat      String
  label     String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}

model VolunteerRequest {
  id                Int      @id @default(autoincrement())
  fullName          String
  email             String
  phone             String?
  professionalField String?
  skills            String?
  yearsOfExperience String?
  motivation        String
  referralSource    String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model EmergencyReport {
  id                Int      @id @default(autoincrement())
  ticketNumber      String   @unique
  user              User?    @relation(fields: [userId], references: [id])
  userId            Int?
  incidentType      String?
  reporterName      String?
  reporterPhone     String?
  reporterEmail     String?
  description       String?
  audioFileUrl      String?
  audioDuration     Float?
  audioMimeType     String?
  attachments       Json?
  stationName       String?
  stationPhone      String?
  stationAddress    String?
  stationLatitude   Float?
  stationLongitude  Float?
  stationDistance   Float?
  nearestStationId  Int?
  gpsLatitude       Float?
  gpsLongitude      Float?
  gpsAccuracy       Float?
  gpsAddress        String?
  mapsLink          String?
  status            String   @default("new")
  priority          String   @default("high")
  assignedVolunteerId Int?
  assignedBy        User?    @relation("AssignedEmergencyReports", fields: [assignedById], references: [id])
  assignedById      Int?
  assignmentNote    String?
  dueAt             DateTime?
  assignedAt        DateTime?
  unassignedAt      DateTime?
  adminNotes        String?
  emailStatus       String   @default("queued")
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assignmentHistory EmergencyReportAssignment[]

  @@index([ticketNumber])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

/// Append-only history of emergency-report assignments to responders.
model EmergencyReportAssignment {
  id          Int             @id @default(autoincrement())
  report      EmergencyReport @relation(fields: [reportId], references: [id])
  reportId    Int
  assignee    User            @relation("AssignmentsReceived", fields: [assigneeId], references: [id])
  assigneeId  Int
  assignedBy  User?           @relation("AssignmentsMade", fields: [assignedById], references: [id])
  assignedById Int?
  note        String?
  assignedAt  DateTime        @default(now())
  unassignedAt DateTime?
  status      String          @default("assigned") // assigned | unassigned

  @@index([reportId])
  @@index([assigneeId])
  @@index([status])
}

model Specialist {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  phone       String?
  specialty   String
  bio         String?
  avatarUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedBookings Booking[]

  @@index([specialty])
  @@index([isActive])
}

model Booking {
  id                    Int       @id @default(autoincrement())
  ticketNumber          String    @unique
  fullName              String
  email                 String
  phone                 String
  specialist            String?
  preferredDate         DateTime?
  preferredTime         String?
  caseDescription       String
  paymentMethod         String?
  paymentReference      String?
  status                String    @default("new")
  assignedVolunteerId   Int?
  assignedSpecialistId  Int?
  adminNotes            String?
  emailStatus           String    @default("queued")
  submittedAt           DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignedSpecialist Specialist? @relation(fields: [assignedSpecialistId], references: [id])

  @@index([ticketNumber])
  @@index([status])
  @@index([email])
  @@index([assignedSpecialistId])
  @@index([createdAt])
}

model Enquiry {
  id                Int      @id @default(autoincrement())
  ticketNumber      String   @unique
  name              String
  email             String
  phone             String?
  subject           String?
  message           String
  channel           String   @default("form")
  status            String   @default("new")
  adminNotes        String?
  emailStatus       String   @default("queued")
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([createdAt])
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  ticketNumber      String?
  reportType        String
  recipientEmail    String
  subject           String
  status            String   @default("queued")
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([ticketNumber])
  @@index([reportType])
  @@index([status])
  @@index([createdAt])
}

model Member {
  id          Int      @id @default(autoincrement())
  name        String
  role        String
  bio         String?
  email       String?
  linkedin    String?
  twitter     String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model CaseResponse {
  id          Int      @id @default(autoincrement())
  case        Case     @relation(fields: [caseId], references: [id])
  caseId      Int
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
  responseText String
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([authorId])
}

// =========================================================
// MONETIZATION: courses, credit wallet, orders, promotions,
// payments, referrals, refunds
//
// Money is stored as integer minor units (GHS pesewas).
// Status/type fields are plain strings (project convention) with
// valid values enforced by the application layer.
// Idempotency is guaranteed by unique keys on:
//   PaymentAttempt.idempotencyKey / providerReference
//   CreditLedgerEntry.idempotencyKey
//   PromotionRedemption.idempotencyKey
//   WebhookEvent providerEventId
// =========================================================

model Course {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  title        String
  description  String?
  level        String?
  duration     String?
  category     String?
  imageUrl     String?
  price        Int               @default(0) // GHS pesewas (0 = free)
  currency     String            @default("GHS")
  creditsPrice Int               @default(0) // 0 = not purchasable with credits
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  enrolments   CourseEnrolment[]

  @@index([active, sortOrder])
}

model CourseEnrolment {
  id              Int             @id @default(autoincrement())
  user            User            @relation(fields: [userId], references: [id])
  userId          Int
  course          Course          @relation(fields: [courseId], references: [id])
  courseId        Int
  source          String          @default("PURCHASE") // PURCHASE | CREDITS | PROMOTION | REFERRAL | ADMIN
  status          String          @default("active")   // active | completed | revoked
  order           Order?          @relation(fields: [orderId], references: [id])
  orderId         Int?
  payment         PaymentAttempt? @relation(fields: [paymentId], references: [id])
  paymentId       Int?
  progressPercent Float           @default(0)
  grantedAt       DateTime        @default(now())
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model CreditPackage {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  description    String?
  baseCredits    Int
  bonusCredits   Int      @default(0)
  totalCredits   Int
  price          Int      // GHS pesewas
  currency       String   @default("GHS")
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  displayOrder   Int      @default(0)
  promotionLabel String?
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, displayOrder])
}

model CreditWallet {
  id                Int                 @id @default(autoincrement())
  user              User                @relation(fields: [userId], references: [id])
  userId            Int                 @unique
  availableBalance  Int                 @default(0)
  reservedBalance   Int                 @default(0)
  lifetimePurchased Int                 @default(0)
  lifetimeBonus     Int                 @default(0)
  lifetimeSpent     Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  ledgerEntries     CreditLedgerEntry[]

  @@index([userId])
}

model CreditLedgerEntry {
  id              Int          @id @default(autoincrement())
  wallet          CreditWallet @relation(fields: [walletId], references: [id])
  walletId        Int
  user            User         @relation(fields: [userId], references: [id])
  userId          Int
  type            String // PURCHASE | SIGNUP_BONUS | PROMOTION_BONUS | REFERRAL_BONUS | ADMIN_ADJUSTMENT | COURSE_PURCHASE | REFUND | REVERSAL | RESERVATION | RESERVATION_RELEASE | EXPIRATION
  amount          Int          // signed: positive = credit, negative = debit
  balanceBefore   Int
  balanceAfter    Int
  description     String?
  idempotencyKey  String       @unique
  sourceType      String?
  sourceId        Int?
  expiresAt       DateTime?
  createdByUserId Int?
  createdAt       DateTime     @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

model Order {
  id                 Int          @id @default(autoincrement())
  orderNumber        String       @unique
  user               User         @relation(fields: [userId], references: [id])
  userId             Int
  orderType          String       // COURSE | CREDIT_PACKAGE
  status             String       @default("CREATED") // CREATED | PENDING_PAYMENT | PAID | FULFILLED | FAILED | CANCELLED | EXPIRED | REFUNDED | PARTIALLY_REFUNDED
  currency           String       @default("GHS")
  subtotalAmount     Int          @default(0)
  discountAmount     Int          @default(0)
  taxAmount          Int          @default(0)
  totalAmount        Int          @default(0)
  appliedPromotion   Promotion?   @relation(fields: [appliedPromotionId], references: [id])
  appliedPromotionId Int?
  appliedPromoCode   PromoCode?   @relation(fields: [appliedPromoCodeId], references: [id])
  appliedPromoCodeId Int?
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  paidAt             DateTime?
  fulfilledAt        DateTime?
  cancelledAt        DateTime?
  expiresAt          DateTime?
  items              OrderItem[]
  paymentAttempts    PaymentAttempt[]
  redemptions        PromotionRedemption[]
  enrolments         CourseEnrolment[]
  refunds            Refund[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int
  productType String   // COURSE | CREDIT_PACKAGE
  productId   Int
  productName String
  quantity    Int      @default(1)
  unitPrice   Int
  totalPrice  Int
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productType, productId])
}

model PaymentAttempt {
  id                Int             @id @default(autoincrement())
  order             Order           @relation(fields: [orderId], references: [id])
  orderId           Int
  user              User            @relation(fields: [userId], references: [id])
  userId            Int
  provider          String          @default("paystack")
  providerReference String          @unique
  status            String          @default("CREATED") // CREATED | INITIALIZED | PENDING | PROCESSING | SUCCESSFUL | FAILED | CANCELLED | EXPIRED | REFUNDED | PARTIALLY_REFUNDED
  amount            Int
  currency          String          @default("GHS")
  channel           String?
  authorizationCode String?
  providerResponse  Json?
  failureCode       String?
  failureMessage    String?
  idempotencyKey    String          @unique
  initializedAt     DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  webhookEvents     WebhookEvent[]
  refunds           Refund[]
  enrolments        CourseEnrolment[]

  @@index([orderId])
  @@index([userId])
  @@index([providerReference])
  @@index([status])
}

model Promotion {
  id                     Int                @id @default(autoincrement())
  internalName           String
  publicTitle            String?
  publicDescription      String?
  promotionType          String             // BONUS_CREDITS | PERCENTAGE_DISCOUNT | FIXED_DISCOUNT | FREE_COURSE | COURSE_BUNDLE | SIGNUP_REWARD | REFERRAL_REWARD
  status                 String             @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | PAUSED | EXPIRED | ARCHIVED
  codeRequired           Boolean            @default(false)
  bonusCredits           Int                @default(0)
  discountType           String?            // PERCENT | FIXED
  discountValue          Int                @default(0)
  minimumPurchaseAmount  Int                @default(0)
  minimumCreditPackageId Int?
  eligibleProductType    String?            // COURSE | CREDIT_PACKAGE
  eligibleCourseIds      Int[]              @default([])
  eligiblePackageIds     Int[]              @default([])
  eligibleUserSegment    String?            // NEW | EXISTING
  firstPurchaseOnly      Boolean            @default(false)
  perUserRedemptionLimit Int                @default(1)
  totalRedemptionLimit   Int?
  redemptionCount        Int                @default(0)
  stackable              Boolean            @default(false)
  priority               Int                @default(0)
  bannerEnabled          Boolean            @default(false)
  modalEnabled           Boolean            @default(false)
  startAt                DateTime?
  endAt                  DateTime?
  createdByUserId        Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  orders                 Order[]
  redemptions            PromotionRedemption[]
  promoCodes             PromoCode[]

  @@index([status])
  @@index([promotionType])
  @@index([startAt, endAt])
}

model PromoCode {
  id                    Int             @id @default(autoincrement())
  code                  String          @unique
  normalizedCode        String          @unique
  type                  String          @default("PROMO") // PROMO | REFERRAL
  status                String          @default("ACTIVE") // ACTIVE | DISABLED | EXPIRED
  promotion             Promotion?      @relation(fields: [promotionId], references: [id])
  promotionId           Int?
  owner                 User?           @relation("PromoCodeOwner", fields: [ownerUserId], references: [id])
  ownerUserId           Int?
  maxRedemptions        Int?
  maxRedemptionsPerUser Int             @default(1)
  redemptionCount       Int             @default(0)
  startAt               DateTime?
  endAt                 DateTime?
  createdAt             DateTime        @default(now())
  orders                Order[]
  referrals             ReferralRelationship[]

  @@index([type])
  @@index([status])
  @@index([ownerUserId])
}

model PromotionRedemption {
  id                  Int       @id @default(autoincrement())
  promotion           Promotion @relation(fields: [promotionId], references: [id])
  promotionId         Int
  user                User      @relation(fields: [userId], references: [id])
  userId              Int
  order               Order?    @relation(fields: [orderId], references: [id])
  orderId             Int?
  paymentId           Int?
  creditLedgerEntryId Int?
  discountAmount      Int       @default(0)
  bonusCredits        Int       @default(0)
  status              String    @default("REDEEMED") // REDEEMED | REVERSED
  idempotencyKey      String    @unique
  redeemedAt          DateTime  @default(now())
  reversedAt          DateTime?

  @@index([userId])
  @@index([promotionId])
  @@index([orderId])
}

model ReferralRelationship {
  id                  Int       @id @default(autoincrement())
  referrer            User      @relation("Referrer", fields: [referrerUserId], references: [id])
  referrerUserId      Int
  referred            User      @relation("Referred", fields: [referredUserId], references: [id])
  referredUserId      Int
  referralCode        PromoCode @relation(fields: [referralCodeId], references: [id])
  referralCodeId      Int
  status              String    @default("PENDING") // PENDING | QUALIFIED | REWARDED
  qualifyingOrderId   Int?
  qualifyingPaymentId Int?
  rewardCredits       Int       @default(0)
  qualifiedAt         DateTime?
  rewardedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@unique([referrerUserId, referredUserId])
  @@index([referredUserId])
  @@index([referralCodeId])
  @@index([status])
}

model WebhookEvent {
  id               Int             @id @default(autoincrement())
  provider         String          @default("paystack")
  providerEventId  String?         // Paystack does not always supply a stable event id; dedupe by paymentReference + payload hash instead
  eventType        String
  payloadHash      String?
  paymentReference String?
  paymentAttemptId Int?
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
  processingStatus String          @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | FAILED | IGNORED | DUPLICATE
  attemptCount     Int             @default(0)
  lastError        String?
  receivedAt       DateTime        @default(now())
  processedAt      DateTime?

  @@index([provider, eventType])
  @@index([processingStatus])
  @@index([paymentReference])
}

model Refund {
  id                Int             @id @default(autoincrement())
  payment           PaymentAttempt  @relation(fields: [paymentId], references: [id])
  paymentId         Int
  order             Order           @relation(fields: [orderId], references: [id])
  orderId           Int
  amount            Int
  currency          String          @default("GHS")
  reason            String?
  status            String          @default("PENDING") // PENDING | PROCESSED | FAILED | REJECTED
  providerReference String?
  requestedBy       User?           @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  requestedById     Int?
  createdAt         DateTime        @default(now())
  processedAt       DateTime?

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
}

/// Fixed catalogue of premium plans. Prices are in GHS pesewas and are set
/// server-side only; never derived from client input.
model SubscriptionPlan {
  id            Int              @id @default(autoincrement())
  code          String           @unique // monthly | six_months | annual
  name          String
  description   String?
  pricePesewas  Int
  currency      String           @default("GHS")
  durationUnit  String           @default("MONTH") // MONTH | YEAR
  durationValue Int              @default(1)
  active        Boolean          @default(true)
  displayOrder  Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@index([active])
}

model Subscription {
  id        Int                @id @default(autoincrement())
  userId    Int
  planId    Int?
  paymentId Int?               @unique
  source    String             @default("paystack") // paystack | coupon | promotion | referral | manual_admin
  startsAt  DateTime
  expiresAt DateTime
  status    String             @default("active") // active | expired | cancelled | refunded
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan?  @relation(fields: [planId], references: [id])
  payment   SubscriptionPayment? @relation("SubscriptionPaymentSubscription", fields: [paymentId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

/// Paystack transaction record for a premium subscription purchase.
model SubscriptionPayment {
  id                  Int            @id @default(autoincrement())
  userId              Int
  planId              Int
  provider            String         @default("paystack")
  providerReference   String         @unique
  idempotencyKey      String         @unique
  amountPesewas       Int
  currency            String         @default("GHS")
  channel             String?
  status              String         @default("PENDING") // PENDING | PAID | FAILED | CANCELLED | REFUNDED
  referralCodeEntered String?
  referredUserId      Int?
  paidAt              DateTime?
  verifiedAt          DateTime?
  rawProviderStatus   String?
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id])
  plan                SubscriptionPlan @relation(fields: [planId], references: [id])
  subscription        Subscription?  @relation("SubscriptionPaymentSubscription")
  referral            Referral?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Referral reward: exactly one hour of premium entitlement granted to the
/// referrer after the referred account's FIRST verified subscription purchase.
model Referral {
  id                    Int                @id @default(autoincrement())
  referrerUserId        Int
  referredUserId        Int
  referralCode          String
  subscriptionPaymentId Int?               @unique
  rewardHours           Int                @default(1)
  status                String             @default("PENDING") // PENDING | REWARDED | REVERSED | EXPIRED
  rewardGrantedAt       DateTime?
  rewardExpiresAt       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  referrer              User               @relation("ReferrerReferrals", fields: [referrerUserId], references: [id])
  referred              User               @relation("ReferredBy", fields: [referredUserId], references: [id])
  payment               SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id])

  @@unique([referrerUserId, referredUserId])
  @@index([referredUserId])
  @@index([status])
}

/// Append-only audit of every premium entitlement grant, enabling idempotent
/// one-time benefits and full reversal support.
model PremiumBenefitLedger {
  id               Int       @id @default(autoincrement())
  userId           Int
  benefitType      String    // signup_trial | first_subscription_bonus | referral_reward | admin_adjustment | subscription_purchase
  durationMinutes  Int
  sourceId         String?   // e.g. SubscriptionPayment id, referral id, admin action id
  status           String    @default("granted") // granted | reversed | expired
  grantedAt        DateTime  @default(now())
  expiresAt        DateTime?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, benefitType, sourceId])
  @@index([userId])
  @@index([benefitType])
}

/// Impression/dismissal/click tracking for the fixed server-driven promotions
/// (signup trial + first subscription bonus). Used to enforce display caps
/// (max once/session, max once/day) and audit promotion engagement.
model PromotionEngagement {
  id            Int      @id @default(autoincrement())
  userId        Int
  promoKey      String   // signup_trial | first_subscription_bonus
  placement     String   // signup | subscriptions
  platform      String?
  seenCount     Int      @default(1)
  lastSeenAt    DateTime @default(now())
  dismissedAt   DateTime?
  dismissCount  Int      @default(0)
  clickCount    Int      @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, promoKey, placement])
}

/// An admin broadcast to a selected audience. Recipients get an in-app
/// Notification plus a queued individual email; delivery is tracked per
/// recipient (no double-send, read tracking).
model Broadcast {
  id           Int                  @id @default(autoincrement())
  title        String
  body         String
  link         String?
  audience     String               @default("all_users") // all_users | volunteers | investigators | volunteers_and_investigators
  createdBy    User                 @relation("BroadcastsCreated", fields: [createdById], references: [id])
  createdById  Int
  createdAt    DateTime             @default(now())
  recipients   BroadcastRecipient[]
}

model BroadcastRecipient {
  id             Int                 @id @default(autoincrement())
  broadcast      Broadcast           @relation(fields: [broadcastId], references: [id])
  broadcastId    Int
  recipient      User?               @relation("BroadcastsReceived", fields: [recipientId], references: [id])
  recipientId    Int?
  recipientEmail String?
  notificationId Int?                @unique
  emailStatus    String              @default("queued") // queued | sent | failed | skipped
  emailError     String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@unique([broadcastId, recipientId])
  @@index([recipientId])
  @@index([emailStatus])
}

/// A device enrolled in the Stolen Device Protection feature. The mobile app
/// registers itself once; heartbeats update last-seen/location and the owner
/// (or staff) can mark the device as stolen, which raises a theft report and
/// alerts the dashboard.
model Device {
  id                   Int                 @id @default(autoincrement())
  user                 User                @relation(fields: [userId], references: [id])
  userId               Int
  internalDeviceId     String              // install-time ID generated by the app
  deviceName           String?
  platform             String              @default("ANDROID") // ANDROID | IOS | WEB
  deviceModel          String?
  osVersion            String?
  appVersion           String?
  status               String              @default("ACTIVE") // ACTIVE | STOLEN | RECOVERED | UNPAIRED
  protectionEnabled    Boolean             @default(true)
  sendLocationEnabled  Boolean             @default(true)
  stealMode            String              @default("silent") // silent | helper | none
  notifyDashboard      Boolean             @default(true)
  emergencyContactName String?
  emergencyContactPhone String?
  suspiciousThreshold  Int                 @default(3)
  riskScore            Int                 @default(0)
  riskSignals          Json?               // accumulated suspicious-event counters
  markedStolenAt       DateTime?
  recoveredAt          DateTime?
  lastSeenAt           DateTime?
  lastLatitude         Float?
  lastLongitude        Float?
  lastAddress          String?
  lastAccuracy         Float?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  heartbeats           DeviceHeartbeat[]
  theftReports         StolenDeviceReport[]

  @@unique([userId, internalDeviceId])
  @@index([userId])
  @@index([status])
  @@index([lastSeenAt])
}

/// Append-only location / presence beacon from a protected device.
model DeviceHeartbeat {
  id          Int       @id @default(autoincrement())
  device      Device    @relation(fields: [deviceId], references: [id])
  deviceId    Int
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  address     String?
  battery     Float?
  receivedAt  DateTime  @default(now())

  @@index([deviceId])
  @@index([receivedAt])
}

/// A theft case created when a device is marked STOLEN (by owner or staff) or
/// when the suspicious-event threshold is crossed from heartbeats.
model StolenDeviceReport {
  id               Int       @id @default(autoincrement())
  ticketNumber     String    @unique
  user             User      @relation(fields: [userId], references: [id])
  userId           Int
  device           Device    @relation(fields: [deviceId], references: [id])
  deviceId         Int
  status           String    @default("open") // open | investigating | resolved | closed
  trigger          String    @default("manual") // manual | suspicious_events | heartbeat
  description      String?
  riskLevel        String    @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  latitude         Float?
  longitude        Float?
  address          String?
  reportedByUserId Int?
  reportedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([deviceId])
  @@index([ticketNumber])
}
