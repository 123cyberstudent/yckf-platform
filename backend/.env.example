# Environment: development or production
NODE_ENV=development

# Server port (Railway supplies PORT automatically in production)
PORT=4001

# =============================================================================
# REQUIRED IN PRODUCTION (Railway Variables)
# The backend refuses to start in production without all four of these.
# Generate JWT secrets with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice so JWT_SECRET and REFRESH_TOKEN_SECRET are DIFFERENT values.
# =============================================================================

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@host:5432/yckf_backend?schema=public&sslmode=require"

# Access-token signing secret (long random hex, keep secret)
JWT_SECRET=replace-with-a-long-random-secret

# Refresh-token signing secret (long random hex, different from JWT_SECRET, keep secret)
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# AES key used to encrypt sensitive report notes at rest (long random secret)
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Paystack secret key (REQUIRED IN PRODUCTION for checkout + webhooks).
# Test keys start with sk_test_, live keys with sk_live_. NEVER put this in the app.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Optional overrides (defaults shown)
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_CALLBACK_URL=https://yckf.app/paystack/return

# =============================================================================
# OPTIONAL
# =============================================================================

# Allowed CORS origins (comma-separated, no trailing slashes).
# Used by the web dashboard; native mobile apps do not need to be listed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# JWT expiry overrides (defaults: 1h / 7d)
# ACCESS_TOKEN_EXPIRES=1h
# REFRESH_TOKEN_EXPIRES=7d

# Redis URL for optional caching; omitted to run without Redis
# REDIS_URL=redis://localhost:6379

# SMTP (email delivery). OTP codes and report emails are logged (not sent)
# when SMTP is not configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="YCKF <you@example.com>"
# SMTP_SECURE=true          # set to true for port 465 (SSL); defaults to port===465

# Resend REST API (PREFERRED over SMTP: HTTPS, no SMTP egress/port issues).
# Set RESEND_API_KEY (re_...) plus EMAIL_FROM to send via Resend's REST API.
# Get a key at https://resend.com/api-keys. Free tier only delivers to the
# account's verified email until a sending domain is added.
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM="YCKF <onboarding@resend.dev>"

# SMS delivery. OTP codes are logged (not sent) when SMS_PROVIDER is unset.
# To enable Africa's Talking:
# SMS_PROVIDER=africastalking
# AFRICASTALKING_API_KEY=your_at_api_key
# AFRICASTALKING_USERNAME=your_at_username
# AFRICASTALKING_FROM=YCKF          # optional alphanumeric sender / short code
#
# Default account phone numbers (SMS OTP recipients):
#   mypracticalworks@gmail.com (SUPER_ADMIN) -> +233553141199  (MTN)
#   user@yckf.org (USER)                     -> +233505313578  (Telcel)
# To enable Twilio instead:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+12025550123

# Evidence retention (defaults: 90 days, ./cold_storage)
# EVIDENCE_RETENTION_DAYS=90
# COLD_STORAGE_PATH=cold_storage

# WhatsApp / Telegram webhooks (optional)
# WHATSAPP_VERIFY_TOKEN=your_verify_token
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=yckf-telegram-verify

# Two-factor "remember this device" window in days (default: 30)
# TWO_FACTOR_REMEMBER_DAYS=30

# Staff access code for the Management Login gate (Super Admin / Admin /
# Volunteer / Investigator). The login page asks for this code before any
# management role portal is shown. If unset, the gate is disabled. Never put
# the real value in the repo - set it in the Railway Variables instead.
# STAFF_ACCESS_CODE=replace-with-a-strong-code
