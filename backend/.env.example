# Environment: development or production
NODE_ENV=development

# Server port (Railway supplies PORT automatically in production)
PORT=4001

# =============================================================================
# REQUIRED IN PRODUCTION (Railway Variables)
# The backend refuses to start in production without all four of these.
# Generate JWT secrets with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice so JWT_SECRET and REFRESH_TOKEN_SECRET are DIFFERENT values.
# =============================================================================

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@host:5432/yckf_backend?schema=public&sslmode=require"

# Access-token signing secret (long random hex, keep secret)
JWT_SECRET=replace-with-a-long-random-secret

# Refresh-token signing secret (long random hex, different from JWT_SECRET, keep secret)
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# AES key used to encrypt sensitive report notes at rest (long random secret)
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# =============================================================================
# OPTIONAL
# =============================================================================

# Allowed CORS origins (comma-separated, no trailing slashes).
# Used by the web dashboard; native mobile apps do not need to be listed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# JWT expiry overrides (defaults: 1h / 7d)
# ACCESS_TOKEN_EXPIRES=1h
# REFRESH_TOKEN_EXPIRES=7d

# Redis URL for optional caching; omitted to run without Redis
# REDIS_URL=redis://localhost:6379

# SMTP (optional; email is logged only when SMTP is not configured)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="YCKF <you@example.com>"

# Evidence retention (defaults: 90 days, ./cold_storage)
# EVIDENCE_RETENTION_DAYS=90
# COLD_STORAGE_PATH=cold_storage

# WhatsApp / Telegram webhooks (optional)
# WHATSAPP_VERIFY_TOKEN=your_verify_token
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=yckf-telegram-verify

# Two-factor "remember this device" window in days (default: 30)
# TWO_FACTOR_REMEMBER_DAYS=30
